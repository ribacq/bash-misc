#!/bin/bash

if [ "$1" == '-h' ]; then
	echo 'gct [-u username|-a]                   time since latest commit'
	echo 'gct [-u username|-a] -d [date]         cumulated commit time on specified date (defaults to today)'
	echo 'gct [-u username|-a] -s [-v] [date]    cumulated commit time since specified date (defaults to today - 7 days)'
	echo '                                       with -v, prints details for each day'
	echo 'gct [-u username|-a] prefix            cumulated commit time for commits with specified prefix'
	echo
	echo '-u username: only commits from "username", the email prefix (part before the @)'
	echo '-a: commits by all users'
	echo 'defaults to prefix of "git config user.email"'
	echo
	echo 'COMMIT FORMAT'
	echo 'prefix Thh:mm message'
	exit 0
fi

user_email_prefix="$(git config user.email | cut -d'@' -f1)"
if [ "$1" == '-u' ]; then
	shift
	user_email_prefix="$1"
	shift
elif [ "$1" == '-a' ]; then
	shift
	user_email_prefix=''
fi

if [ -z "$1" ]; then
	if [ -n "$user_email_prefix" ]; then
		latest="$(git log --branches=* --pretty=format:'%at %s <%al>' | grep "<${user_email_prefix}>" | head -1)"
	else
		latest="$(git log --branches=* --pretty=format:'%at %s <%al>' -1)"
	fi
	echo "$latest"
	latest="$(echo -n "$latest" | cut -d' ' -f1)"
	qalc -t "(timestamp(now) - $latest) seconds"
	exit 0
fi

if [ "$1" == '-d' ]; then
	shift
	d="$(date -I)"
	[ -n "$*" ] && d="$(date -I --date="$*")"
	commits="$(git log --branches=* --pretty=format:'%aI %s <%al>' --no-color | grep "$d" | grep -vi 'Merge')"
	if [ -n "$user_email_prefix" ]; then
		commits="$(echo "$commits" | grep "<${user_email_prefix}>")"
	fi
	echo "=== commits on $d ==="
	echo
	echo "${commits}"
	echo
	commits="$(echo -n "${commits}" | cut -d' ' -f3)"
elif [ "$1" == '-s' ] || [ "$1" == '-sv' ]; then
	verbose=''
	[ "$1" == '-sv' ] && verbose='1'
	shift
	[ "$1" == '-v' ] && verbose='1' && shift

	sinceInput='last monday'
	[ -n "$*" ] && sinceInput="$*"
	s="$(date -Isec --date="$sinceInput")"

	echo "=== commits since $sinceInput ==="
	commits="$(git log --branches=* --pretty=format:'%aI %s <%al>' --no-color --since="$s" | grep -vi 'Merge')"
	if [ -n "$user_email_prefix" ]; then
		commits="$(echo "$commits" | grep "<${user_email_prefix}>")"
	fi

	if [ -n "$verbose" ]; then
		days="$(echo -n "$commits" | grep -o -P '\d{4}-\d{2}-\d{2}T' | tr -d T | sort | uniq )"
		echo
		for day in $days
		do
			sum="$(echo -n "$commits" | grep "$day" | grep -o -P ' T\d{2}:\d{2}' | tr -d 'T ' | tr '\n' +)"
			echo "$(date --date="${day}" +%a) ${day}: $(qalc -t "(${sum}) hours" | tr -d + | tr -s ' ')"
		done
		echo
	fi

	commits="$(echo -n "${commits}" | cut -d' ' -f3)"
else
	prefix=$1
	commits="$(git log --branches=* --pretty=format:'%s <%al>' --no-color | grep -P "^${prefix} T\d{2}:\d{2}\b")"
	if [ -n "$user_email_prefix" ]; then
		commits="$(echo "$commits" | grep "<${user_email_prefix}>")"
	fi
fi

sum="$(echo -n "$commits" | grep -o -P 'T\d{2}:\d{2}' | tr -d T | tr '\n' +)"

[ -z "$sum" ] && echo "no time in log for prefix '$prefix'" && exit 1

qalc -t "(${sum}) hours"
qalc -t "${sum}"

exit 0
